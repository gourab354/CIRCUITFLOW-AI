{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "CircuitFlow AI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$APPDATA/*", "$DOCUMENT/*", "$DOWNLOAD/*"]
      },
      "shell": {
        "all": true,
        "open": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://127.0.0.1:8000/*", "ws://127.0.0.1:8000/*"]
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.circuitflow.ai",
      "icon": [
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "CircuitFlow AI — Desktop PCB Design & Engineering",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  }
}
